# Copy to .env and fill in. .env is gitignored and never committed.

# FR-374 DR-17: keep React Native's global fetch. Since SDK 56, Expo swaps in
# expo/fetch at startup unless this is 1/true (expo/src/winter/runtime.native.ts:35).
# Metro inlines it at bundle time, so it must be set for EVERY build: local .env,
# each eas.json build profile (already set there), and any other bundling env.
# After changing it, restart Metro with --clear so cached transforms pick it up.
EXPO_PUBLIC_USE_RN_FETCH=1

# FR-374 DR-18: set to 1 to run the dev-only Hermes crypto self-test
# (src/dev/cryptoSelfTest.ts) at startup of a DEBUG build. Release bundles never
# contain it. Leave unset normally.
# EXPO_PUBLIC_CRYPTO_SELFTEST=1

# WalletConnect v2 project ID (cloud.walletconnect.com). See README.md.
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Supabase (messaging).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
